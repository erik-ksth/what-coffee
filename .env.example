# Google reCAPTCHA v2 checkbox keys, created at https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Contact email delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=techsupport@whatcoffeeandbakery.com
CONTACT_FROM_EMAIL="What Coffee <website@whatcoffeeandbakery.com>"

# Optional contact-form abuse-protection overrides
CONTACT_RATE_LIMIT_MAX=
CONTACT_RATE_LIMIT_WINDOW_SECONDS=
CONTACT_MAX_BODY_BYTES=

# Instagram Feed
INSTAGRAM_ACCESS_TOKEN=

# Optional override; the public production Measurement ID is configured in src/config/analytics.ts
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
